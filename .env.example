# Default mode is credential-free and deterministic.
# Use DEMO_MODE=atlas to enable the connected MongoDB Atlas + LLM path.
DEMO_MODE=local

# MongoDB Atlas, required only when DEMO_MODE=atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGODB_DB=supply_chain_agent

# Tenant / actor scoping
REALM_ID=demo_realm
AGENT_ID=supply_chain_resolution_agent
USER_ID=planner_001

# OpenAI-compatible LLM, required only when DEMO_MODE=atlas.
# Do not commit real keys. Leave LLM_BASE_URL blank for the default OpenAI API.
LLM_PROVIDER=openai_compatible
LLM_API_KEY=<your-llm-api-key>
LLM_BASE_URL=
LLM_MODEL=gpt-4.1-mini
# Optional for gateways that expect API keys in a custom header, e.g. api-key.
LLM_API_KEY_HEADER=
# Optional. Set true for providers/models that use the OpenAI Responses API.
LLM_USE_RESPONSES_API=false

# Atlas AI features
ATLAS_EMBEDDING_MODEL=voyage-4
ATLAS_RERANK_MODEL=rerank-2.5-lite
ATLAS_NATIVE_RERANK_ENABLED=true