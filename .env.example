# Supply Chain Resolution Agent demo configuration.
#
# Safe default: local mode is credential-free, deterministic, and customer-shareable.
# Switch to DEMO_MODE=atlas only when you want the connected Atlas + LLM showcase.
DEMO_MODE=local

# MongoDB Atlas connection, required only when DEMO_MODE=atlas.
# Keep real connection strings in .env only. Never commit .env.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGODB_DB=supply_chain_agent

# Tenant / actor scoping used by memories, episodes, retrieval filters, and drafts.
# Defaults are fine for a single demo tenant.
REALM_ID=demo_realm
AGENT_ID=supply_chain_resolution_agent
USER_ID=planner_001

# OpenAI-compatible LLM, required only when DEMO_MODE=atlas.
# Leave LLM_BASE_URL blank for the default OpenAI API.
# For private gateways, set LLM_BASE_URL and, if needed, LLM_API_KEY_HEADER.
LLM_PROVIDER=openai_compatible
LLM_API_KEY=<your-llm-api-key>
LLM_BASE_URL=
LLM_MODEL=gpt-4.1-mini
# Optional: gateways such as Azure API Management may expect api-key instead of bearer auth.
# LLM_API_KEY_HEADER=api-key
# Optional: set true for providers/models that use the OpenAI Responses API.
# LLM_USE_RESPONSES_API=true

# Atlas AI model names used by Atlas Search / Vector Search definitions.
# Keep these defaults unless your Atlas project uses different model availability.
ATLAS_EMBEDDING_MODEL=voyage-4
ATLAS_RERANK_MODEL=rerank-2.5-lite
ATLAS_NATIVE_RERANK_ENABLED=true

# Search / Vector Search index names. Usually no need to change these.
KNOWLEDGE_VECTOR_INDEX=knowledge_corpus_autoembed
MEMORY_VECTOR_INDEX=agent_memories_autoembed
EPISODE_VECTOR_INDEX=agent_episodes_autoembed
KNOWLEDGE_SEARCH_INDEX=knowledge_corpus_search
